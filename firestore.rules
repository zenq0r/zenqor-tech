// ============================================================
// ⚠️ TIDAK LAGI DI-DEPLOY SECARA BERASINGAN — RUJUKAN SAHAJA.
// zenqor-tech kini berkongsi projek Firebase yang sama dengan zenqor-portal
// (zenqor-portal-a3b2d). Rules sebenar yang di-deploy ialah:
//   ../zenqor-portal/firestore.rules   (bahagian "ZENQOR-TECH" di hujung fail)
// Jangan `firebase deploy` fail ini secara berasingan — ia akan menggantikan
// rules /users, /projects, /claims dll milik zenqor-portal dengan versi yang
// tiada langsung kebenaran untuk koleksi-koleksi tersebut.
// ============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fungsi untuk menyemak sama ada pengguna adalah admin
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. Koleksi Pengguna (RBAC & Profil)
    // PENTING: ini mesti kekal sebagai satu-satunya rule yang sepadan dengan
    // /users/{userId} — jangan biarkan rule generik di bawah turut sepadan
    // dengan path ini, sebab Firestore membenarkan akses jika MANA-MANA satu
    // rule yang sepadan membenarkannya (bukan "rule paling spesifik menang").
    // Sebelum ini, `match /{collection}/{document=**}` turut sepadan dengan
    // /users/{uid} dan allow read:true di situ menyebabkan SEMUA profil
    // pengguna (nama, emel, telefon) boleh dibaca sesiapa sahaja.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // 2. Koleksi Kandungan Awam (senarai eksplisit — BUKAN wildcard)
    // Setiap koleksi yang sah untuk paparan public disenaraikan secara
    // eksplisit di sini. Ini elak sebarang koleksi baru (cth: masa depan
    // "orders" atau "invoices") secara tidak sengaja jadi public-readable
    // hanya kerana namanya sepadan dengan wildcard generik.
    match /portfolio_web/{document=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /portfolio_gaming/{document=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /services/{document=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /navigation/{document=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /config/{document=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    // Kandungan teks generik (hero, about, FAQ, legal pages, dsb.) — lihat
    // content-loader.js. Satu koleksi baru, senang untuk admin edit setiap
    // teks di website tanpa perlu ubah struktur rules setiap kali.
    match /content/{document=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /testimonials/{document=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // 3. Contact Messages — awam boleh CREATE sahaja (hantar borang), tapi
    // tak boleh baca senarai orang lain. Schema/size-validated so a create
    // can't smuggle extra fields or oversized payloads into the inbox.
    match /contact_messages/{document=**} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'company', 'subject', 'message', 'status', 'createdAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 200 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 200 &&
        request.resource.data.message is string && request.resource.data.message.size() <= 5000 &&
        request.resource.data.status == 'UNREAD';
      allow read, update, delete: if isAdmin();
    }

    // 4. Analytics — pageview logging. Sesiapa boleh CREATE (rakam
    // lawatan), tapi hanya admin boleh BACA data agregat. Tiada update/
    // delete sebab setiap dokumen adalah rekod log yang tak sepatutnya
    // diubah selepas dicipta. Schema/size-validated for the same reason
    // as contact_messages above.
    match /analytics_events/{document=**} {
      allow create: if request.resource.data.keys().hasOnly(['page', 'referrer', 'lang', 'timestamp']) &&
        request.resource.data.page is string && request.resource.data.page.size() <= 300;
      allow read: if isAdmin();
    }
  }
}
